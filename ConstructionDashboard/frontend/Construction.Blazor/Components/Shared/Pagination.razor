@if (TotalCount > PageSize)
{
    <div class="pagination" role="navigation" aria-label="Pagination">
        <button type="button" class="btn btn-ghost btn-sm" disabled="@(Page <= 1)" @onclick="() => PageChanged.InvokeAsync(Page - 1)" aria-label="Previous page">
            <i class="icon icon-chevron-left" aria-hidden="true"></i>
        </button>
        <span class="pagination-info">
            Page <strong>@Page</strong> of @TotalPages
        </span>
        <button type="button" class="btn btn-ghost btn-sm" disabled="@(Page >= TotalPages)" @onclick="() => PageChanged.InvokeAsync(Page + 1)" aria-label="Next page">
            <i class="icon icon-chevron-right" aria-hidden="true"></i>
        </button>
    </div>
}
