@page "/schedule"
@layout MainLayout

<PageTitle>Schedule</PageTitle>

<div class="schedule-page">
    <header class="page-header">
        <h1>Schedule</h1>
        <p>Cross-project schedule view with milestone and task tracking.</p>
    </header>

    @if (_loading)
    {
        <div class="loading-state" aria-live="polite">Loading schedule…</div>
    }
    @if (_error is not null)
    {
        <div class="alert alert-error" role="alert">@_error</div>
    }

    @if (!_loading && _error is null)
    {
        <div class="toolbar">
            <div class="toolbar-left">
                <select class="select" @onchange="OnProjectFilterChanged">
                    <option value="">All Projects</option>
                    @foreach (var p in _projects)
                    {
                        <option value="@p.Id" selected="@(_projectId == p.Id)">@p.Name</option>
                    }
                </select>
                <div class="month-navigator">
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="PrevMonth"><i class="icon icon-chevron-left" aria-hidden="true"></i></button>
                    <span class="text-secondary">@GetMonthLabel()</span>
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="NextMonth"><i class="icon icon-chevron-right" aria-hidden="true"></i></button>
                </div>
            </div>
            <div class="toolbar-right">
                <button type="button" class="btn btn-secondary btn-sm"><i class="icon icon-filter" aria-hidden="true"></i>Filter</button>
                <button type="button" class="btn btn-primary"><i class="icon icon-plus" aria-hidden="true"></i>Add Task</button>
            </div>
        </div>

        <div class="toolbar schedule-view-toggle">
            <div class="toolbar-left" style="margin: 0">
                <button type="button" class="btn btn-ghost btn-sm @(_viewMode == "Month" ? "is-active" : "")" @onclick='() => SetViewMode("Month")' style="color: @(_viewMode == "Month" ? "var(--color-accent)" : null)">Month</button>
                <button type="button" class="btn btn-ghost btn-sm @(_viewMode == "Week" ? "is-active" : "")" @onclick='() => SetViewMode("Week")' style="color: @(_viewMode == "Week" ? "var(--color-accent)" : null)">Week</button>
                <button type="button" class="btn btn-ghost btn-sm @(_viewMode == "Day" ? "is-active" : "")" @onclick='() => SetViewMode("Day")' style="color: @(_viewMode == "Day" ? "var(--color-accent)" : null)">Day</button>
            </div>
        </div>

        <div class="card gantt-card">
            <div class="card-header"><div><h2 class="card-title">Gantt Timeline</h2><p class="card-subtitle">Work breakdown and dependencies across active projects</p></div></div>
            <div class="table-container gantt-table-wrap">
                <table class="data-table gantt-table">
                    <thead>
                        <tr><th style="min-width: 260px">Task</th><th style="min-width: 100px">Start</th><th style="min-width: 100px">Finish</th><th style="min-width: 100px">% Complete</th><th style="min-width: 360px">Timeline</th></tr>
                    </thead>
                    <tbody>
                        @if (FilteredTasks.Count == 0)
                        {
                            <tr><td colspan="5" class="empty-state" style="text-align: center">No tasks match the current filters</td></tr>
                        }
                        @foreach (var task in PagedRows)
                        {
                            var children = IsChildRow(task) ? [] : GetChildRows(task);
                            <tr>
                                <td style="font-weight: @(IsChildRow(task) ? 400 : 600); padding-left: @(IsChildRow(task) ? "36px" : null)">@task.Name</td>
                                <td>@ShortDate(task.StartDate)</td>
                                <td>@ShortDate(task.EndDate)</td>
                                <td>@(task.Progress)%</td>
                                <td>
                                    <div class="timeline-cell">
                                        <div class="timeline-track" style="left: @(TimelineLeft(task))%; width: @(TimelineWidth(task))%"></div>
                                        <div class="timeline-progress" style="left: @(TimelineLeft(task))%; width: @(ProgressWidth(task))%"></div>
                                        @if (!IsChildRow(task))
                                        {
                                            <span class="timeline-progress-label text-secondary">@(task.Progress)%</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                            @if (!IsChildRow(task))
                            {
                                @foreach (var child in children)
                                {
                                    <tr>
                                        <td style="padding-left: 36px">@child.Name</td>
                                        <td>@ShortDate(child.StartDate)</td>
                                        <td>@ShortDate(child.EndDate)</td>
                                        <td>@(child.Progress)%</td>
                                        <td>
                                            <div class="timeline-cell">
                                                <div class="timeline-track" style="left: @(TimelineLeft(child))%; width: @(TimelineWidth(child))%"></div>
                                                <div class="timeline-progress" style="left: @(TimelineLeft(child))%; width: @(ProgressWidth(child))%"></div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
            <Pagination Page="_page" PageSize="PageSize" TotalCount="AllVisibleRows.Count" PageChanged="(p) => _page = p" />
        </div>

        <div class="card milestone-card">
            <div class="card-header"><div><h2 class="card-title">Critical Path Milestones</h2><p class="card-subtitle">Next 30 days</p></div></div>
            <div class="table-container">
                <table class="data-table">
                    <thead><tr><th>Project</th><th>Milestone</th><th>Date</th><th>Float</th><th>Status</th></tr></thead>
                    <tbody>
                        @if (_milestones.Count == 0)
                        {
                            <tr><td colspan="5" class="empty-state" style="text-align: center">No upcoming milestones</td></tr>
                        }
                        @foreach (var m in _milestones)
                        {
                            var (className, label) = MilestoneCriticality(m);
                            <tr>
                                <td class="font-mono">@m.ProjectCode</td>
                                <td>@m.Title</td>
                                <td>@Formatters.FormatDate(m.DueDate)</td>
                                <td>@MilestoneFloat(m) days</td>
                                <td><span class="badge @className">@label</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
