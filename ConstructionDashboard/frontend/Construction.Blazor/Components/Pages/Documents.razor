@page "/documents"
@layout MainLayout
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.SfPdfViewer

<PageTitle>Documents</PageTitle>

<div class="documents-page">
    <header class="page-header">
        <h1>Documents</h1>
        <p>RFIs, submittals, drawings, and specification documents</p>
    </header>

    @if (_loading)
    {
        <div class="loading-state" aria-live="polite">Loading documents…</div>
    }
    @if (_error is not null)
    {
        <div class="alert alert-error" role="alert">@_error</div>
    }

    @if (!_loading && _error is null)
    {
        <div class="documents-layout">
            <div class="card document-list-card">
                <SfGrid TValue="RecentDocumentDto" DataSource="@_documents" AllowPaging="true" AllowSorting="true" AllowFiltering="true">
                    <GridEvents RowSelected="OnRowSelected" TValue="RecentDocumentDto"></GridEvents>
                    <GridPageSettings PageSize="10"></GridPageSettings>
                    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu"></GridFilterSettings>
                    <GridSelectionSettings Mode="SelectionMode.Row" Type="Syncfusion.Blazor.Grids.SelectionType.Single"></GridSelectionSettings>
                    <GridColumns>
                        <GridColumn Field="@nameof(RecentDocumentDto.DocumentNumber)" HeaderText="Doc #" Width="120"></GridColumn>
                        <GridColumn Field="@nameof(RecentDocumentDto.Title)" HeaderText="Title" Width="200"></GridColumn>
                        <GridColumn Field="@nameof(RecentDocumentDto.Type)" HeaderText="Type" Width="120"></GridColumn>
                        <GridColumn Field="@nameof(RecentDocumentDto.Revision)" HeaderText="Rev" Width="80"></GridColumn>
                        <GridColumn Field="@nameof(RecentDocumentDto.SubmittedDate)" HeaderText="Submitted" Width="130" Format="yMd" Type="Syncfusion.Blazor.Grids.ColumnType.Date"></GridColumn>
                        <GridColumn Field="@nameof(RecentDocumentDto.Status)" HeaderText="Status" Width="120"></GridColumn>
                    </GridColumns>
                </SfGrid>
            </div>

            <div class="card pdf-viewer-card">
                <SfPdfViewer2 DocumentPath="@SamplePdfUrl" Height="640px" Width="100%"></SfPdfViewer2>
            </div>
        </div>
    }
</div>
