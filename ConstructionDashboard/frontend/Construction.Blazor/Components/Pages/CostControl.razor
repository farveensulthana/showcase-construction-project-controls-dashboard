@page "/cost-control"
@layout MainLayout

<PageTitle>Cost Control</PageTitle>

<div class="cost-control-page">
    <header class="page-header">
        <h1>Cost Control</h1>
        <p>Track budgets, committed spend, forecasts, and change orders.</p>
    </header>

    @if (_loading)
    {
        <div class="loading-state" aria-live="polite">Loading cost control…</div>
    }
    @if (_error is not null)
    {
        <div class="alert alert-error" role="alert">@_error</div>
    }

    @if (!_loading && _error is null && _kpis is not null)
    {
        <div class="kpi-grid">
            <div class="kpi-card">
                <div class="kpi-label">Total Portfolio Budget</div>
                <div class="kpi-value">@Formatters.FormatCompactCurrency(_kpis.TotalPortfolioBudget)</div>
                <div class="kpi-change text-secondary"><i class="icon icon-wallet" aria-hidden="true"></i>24 projects</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Committed Spend</div>
                <div class="kpi-value">@Formatters.FormatCompactCurrency(_kpis.CommittedSpend)</div>
                <div class="kpi-change text-secondary"><i class="icon icon-receipt" aria-hidden="true"></i>@PctOfBudget(_kpis.CommittedSpend, _kpis.TotalPortfolioBudget)</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Forecast at Completion</div>
                <div class="kpi-value">@Formatters.FormatCompactCurrency(_kpis.ForecastAtCompletion)</div>
                <div class="kpi-change @((BudgetDelta ?? 0) >= 0 ? "positive" : "negative")">
                    <i class="icon icon-@((BudgetDelta ?? 0) >= 0 ? "arrow-up-right" : "arrow-down-right")" aria-hidden="true"></i>
                    @Formatters.FormatCompactCurrency(Math.Abs(BudgetDelta ?? 0)) @((BudgetDelta ?? 0) >= 0 ? "under budget" : "over budget")
                </div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Pending Change Orders</div>
                <div class="kpi-value">@Formatters.FormatCompactCurrency(_kpis.PendingChangeOrdersAmount)</div>
                <div class="kpi-change negative"><i class="icon icon-file-warning" aria-hidden="true"></i>@_kpis.PendingChangeOrdersCount pending</div>
            </div>
        </div>

        <div class="two-column-grid">
            <div class="card">
                <div class="card-header"><div><h2 class="card-title">Earned Value Summary</h2><p class="card-subtitle">Year to date</p></div></div>
                <div class="bar-chart">
                    @foreach (var point in _trend)
                    {
                        <div class="bar-group">
                            <div class="bar-pair">
                                <div class="bar" style="height: @(BarHeight(point.Planned))%"></div>
                                <div class="bar is-actual" style="height: @(BarHeight(point.Actual))%"></div>
                            </div>
                            <span class="bar-label">@point.Month</span>
                        </div>
                    }
                </div>
                <div class="earned-value-legend">
                    <span><span class="legend-swatch" style="background: var(--color-accent)"></span>BCWS</span>
                    <span><span class="legend-swatch" style="background: var(--color-success)"></span>ACWP</span>
                </div>
            </div>

            <div class="card">
                <div class="card-header"><div><h2 class="card-title">Cost Variance Heatmap</h2><p class="card-subtitle">By cost code</p></div></div>
                <div class="cost-heatmap">
                    @foreach (var v in _variances)
                    {
                        <div class="cost-heatmap-cell @HeatmapClass(v.VariancePct)">
                            @v.CostCode
                            <br />
                            <span>@(v.VariancePct >= 0 ? "+" : "")@(v.VariancePct)%</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card change-order-card">
            <div class="card-header">
                <div><h2 class="card-title">Pending Change Orders</h2><p class="card-subtitle">Awaiting owner approval</p></div>
                <button type="button" class="btn btn-primary" @onclick="OpenNewChangeOrderModal">
                    <i class="icon icon-plus" aria-hidden="true"></i>New Change Order
                </button>
            </div>
            <div class="toolbar co-toolbar">
                <div class="toolbar-left">
                    <div class="input-with-icon">
                        <i class="icon icon-search" aria-hidden="true"></i>
                        <input type="search" class="input" placeholder="Search CO #, description, project…" value="@_coSearch" @oninput="OnSearchChanged" style="min-width: 240px" />
                    </div>
                    <select class="select" @onchange="OnStatusChanged" style="min-width: 160px">
                        @foreach (var (status, label) in StatusOptions)
                        {
                            <option value="@(status?.ToString() ?? "")" selected="@(_coStatus == status)">@label</option>
                        }
                    </select>
                </div>
                <div class="toolbar-right">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="ExportChangeOrders" disabled="@(FilteredChangeOrders.Count == 0)">
                        <i class="icon icon-download" aria-hidden="true"></i>Export
                    </button>
                </div>
            </div>
            @if (_coLoading)
            {
                <div class="loading-state" aria-live="polite">Loading change orders…</div>
            }
            @if (!_coLoading)
            {
                <div class="table-container">
                    <table class="data-table">
                        <thead><tr><th>CO #</th><th>Project ID</th><th>Description</th><th>Submitted</th><th>Amount</th><th>Status</th></tr></thead>
                        <tbody>
                            @if (PagedChangeOrders.Count == 0)
                            {
                                <tr><td colspan="6" class="empty-state" style="text-align: center">No pending change orders</td></tr>
                            }
                            @foreach (var co in PagedChangeOrders)
                            {
                                <tr role="button" tabindex="0" @onclick="() => _selectedCo = co" @onkeydown="(e) => OnRowKeydown(e, co)">
                                    <td class="font-mono">@co.Number</td>
                                    <td class="truncate" style="max-width: 180px">@co.ProjectId</td>
                                    <td class="truncate" style="max-width: 260px">@co.Description</td>
                                    <td>@(co.RequestDate is not null ? Formatters.FormatDate(co.RequestDate) : "—")</td>
                                    <td style="font-weight: 600">@(co.Amount >= 0 ? "+" : "")@Formatters.FormatCurrency(co.Amount)</td>
                                    <td><span class="badge @StatusBadgeClass[co.Status]">@co.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (FilteredChangeOrders.Count > ChangeOrderPageSize)
                {
                    <Pagination Page="_changeOrderPage" PageSize="ChangeOrderPageSize" TotalCount="FilteredChangeOrders.Count" PageChanged="(p) => _changeOrderPage = p" />
                }
            }
        </div>
    }

    <Modal Open="_selectedCo is not null" Title="@(_selectedCo is not null ? $"Change Order {_selectedCo.Number}" : "")"
           Subtitle="@(_selectedCo is not null ? $"Project {_selectedCo.ProjectId}" : null)" Size="lg" OnClosed="() => _selectedCo = null">
        <ChildContent>
            @if (_selectedCo is not null)
            {
                <div class="modal-detail-grid">
                    <div class="modal-detail-item"><span class="modal-detail-label">Status</span><span class="badge @StatusBadgeClass[_selectedCo.Status]" style="width: fit-content">@_selectedCo.Status</span></div>
                    <div class="modal-detail-item"><span class="modal-detail-label">Amount</span><span class="modal-detail-value">@(_selectedCo.Amount >= 0 ? "+" : "")@Formatters.FormatCurrency(_selectedCo.Amount)</span></div>
                    <div class="modal-detail-item"><span class="modal-detail-label">Requested By</span><span class="modal-detail-value">@(_selectedCo.RequestedBy ?? "—")</span></div>
                    <div class="modal-detail-item"><span class="modal-detail-label">Request Date</span><span class="modal-detail-value">@(_selectedCo.RequestDate is not null ? Formatters.FormatDate(_selectedCo.RequestDate) : "—")</span></div>
                    <div class="modal-detail-item is-span-2"><span class="modal-detail-label">Description</span><span class="modal-detail-value" style="font-weight: 400">@_selectedCo.Description</span></div>
                </div>
            }
        </ChildContent>
    </Modal>

    <Modal Open="_showNewCoModal" Title="New Change Order" Subtitle="Demo template — saved to this view only; nothing is sent to the backend." Size="lg" OnClosed="() => _showNewCoModal = false">
        <ChildContent>
            <div class="modal-form-grid">
                <div class="modal-form-field">
                    <label for="co-project">Project ID</label>
                    <input id="co-project" class="input" type="number" @bind="_draft.ProjectId" @bind:event="oninput" />
                </div>
                <div class="modal-form-field">
                    <label for="co-amount">Amount ($)</label>
                    <input id="co-amount" class="input" type="number" @bind="_draft.Amount" @bind:event="oninput" />
                </div>
                <div class="modal-form-field">
                    <label for="co-requestedBy">Requested By</label>
                    <input id="co-requestedBy" class="input" type="text" @bind="_draft.RequestedBy" @bind:event="oninput" />
                </div>
                <div class="modal-form-field">
                    <label for="co-requestDate">Request Date</label>
                    <input id="co-requestDate" class="input" type="date" @bind="_draft.RequestDate" @bind:format="yyyy-MM-dd" />
                </div>
                <div class="modal-form-field">
                    <label for="co-impactDays">Schedule Impact (days)</label>
                    <input id="co-impactDays" class="input" type="number" @bind="_draft.ImpactDays" @bind:event="oninput" />
                </div>
                <div class="modal-form-field is-span-2">
                    <label for="co-description">Description</label>
                    <textarea id="co-description" class="input" rows="2" @bind="_draft.Description" @bind:event="oninput" required></textarea>
                </div>
                <div class="modal-form-field is-span-2">
                    <label for="co-justification">Justification</label>
                    <textarea id="co-justification" class="input" rows="3" @bind="_draft.Justification" @bind:event="oninput"></textarea>
                </div>
            </div>
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn btn-secondary" @onclick="() => _showNewCoModal = false">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="SaveNewChangeOrder" disabled="@string.IsNullOrWhiteSpace(_draft.Description)">Save Change Order</button>
        </FooterContent>
    </Modal>
</div>
