@page "/workflows"
@layout MainLayout
@using Syncfusion.Blazor.Diagram

<PageTitle>Workflows</PageTitle>

<div class="workflows-page">
    <header class="page-header">
        <h1>Workflows</h1>
        <p>Approval and delivery workflow visualization</p>
    </header>
    <div class="card workflow-diagram-card">
        <SfDiagramComponent Id="workflow-diagram" Width="100%" Height="500px" Nodes="@_nodes" Connectors="@_connectors">
        </SfDiagramComponent>
    </div>
</div>
