@page "/projects"
@layout MainLayout

<PageTitle>Projects</PageTitle>

<div class="projects-page">
    <header class="page-header">
        <h1>Projects</h1>
        <p>Portfolio overview of all active and planned construction projects.</p>
    </header>

    <div class="toolbar">
        <div class="toolbar-left">
            <div class="input-with-icon">
                <i class="icon icon-search" aria-hidden="true"></i>
                <input type="search" class="input" placeholder="Search projects…" value="@_search" @oninput="OnSearchChanged" style="min-width: 240px" />
            </div>
            <select class="select" @onchange="OnStatusChanged" style="min-width: 160px">
                @foreach (var (status, label) in StatusOptions)
                {
                    <option value="@(status?.ToString() ?? "")" selected="@(_status == status)">@label</option>
                }
            </select>
        </div>
        <div class="toolbar-right">
            <button type="button" class="btn btn-secondary btn-sm" @onclick="ExportProjects" disabled="@(FilteredProjects.Count == 0)">
                <i class="icon icon-download" aria-hidden="true"></i>Export
            </button>
            <button type="button" class="btn btn-primary" @onclick="OpenNewProjectModal">
                <i class="icon icon-plus" aria-hidden="true"></i>New Project
            </button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">Loading projects…</div>
    }
    @if (_error is not null)
    {
        <div class="alert alert-error" role="alert">@_error</div>
    }

    @if (!_loading && _error is null)
    {
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr><th>Project ID</th><th>Name</th><th>Location</th><th>Start Date</th><th>Finish Date</th><th>Progress</th><th>Budget</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @if (PagedProjects.Count == 0)
                    {
                        <tr><td colspan="9" class="empty-state" style="text-align: center">No projects match the current filters</td></tr>
                    }
                    @foreach (var p in PagedProjects)
                    {
                        <tr role="button" tabindex="0" @onclick="() => GoToProject(p.Id)" @onkeydown="(e) => OnRowKeydown(e, p.Id)">
                            <td class="font-mono">@p.Code</td>
                            <td class="truncate" style="max-width: 220px">@p.Name</td>
                            <td>@(p.Location ?? "—")</td>
                            <td>@Formatters.FormatDate(p.StartDate)</td>
                            <td>@Formatters.FormatDate(p.EndDate)</td>
                            <td>
                                <div style="min-width: 120px">
                                    <div class="progress-bar" style="max-width: 120px">
                                        <div class="progress-fill @ProgressTone(p.Progress)" style="width: @(p.Progress)%"></div>
                                    </div>
                                    <span class="text-secondary" style="font-size: var(--text-caption-size)">@(p.Progress)%</span>
                                </div>
                            </td>
                            <td>@Formatters.FormatCurrency(p.Budget)</td>
                            <td><span class="badge @StatusBadgeClass[p.Status]">@p.Status</span></td>
                            <td>
                                <button type="button" class="btn btn-ghost btn-icon btn-sm" tabindex="-1" aria-hidden="true">
                                    <i class="icon icon-chevron-right" aria-hidden="true"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="projects-footer">
            <span class="showing-text">
                Showing @((_page - 1) * PageSize + 1)–@Math.Min(_page * PageSize, FilteredProjects.Count) of @FilteredProjects.Count projects
            </span>
            <Pagination Page="_page" PageSize="PageSize" TotalCount="FilteredProjects.Count" PageChanged="(p) => _page = p" />
        </div>
    }

    <Modal Open="_showNewProjectModal" Title="New Project" Subtitle="Demo template — saved to this view only; nothing is sent to the backend." Size="lg" OnClosed="() => _showNewProjectModal = false">
        <ChildContent>
            <div class="modal-form-grid">
                <div class="modal-form-field is-span-2">
                    <label for="proj-name">Project Name</label>
                    <input id="proj-name" class="input" type="text" @bind="_draft.Name" @bind:event="oninput" required />
                </div>
                <div class="modal-form-field">
                    <label for="proj-code">Project Code</label>
                    <input id="proj-code" class="input" type="text" @bind="_draft.Code" @bind:event="oninput" />
                </div>
                <div class="modal-form-field">
                    <label for="proj-status">Status</label>
                    <select id="proj-status" class="select" @bind="_draft.Status">
                        @foreach (var s in NewProjectStatusOptions)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
                <div class="modal-form-field">
                    <label for="proj-location">Location</label>
                    <input id="proj-location" class="input" type="text" @bind="_draft.Location" @bind:event="oninput" />
                </div>
                <div class="modal-form-field">
                    <label for="proj-manager">Project Manager</label>
                    <input id="proj-manager" class="input" type="text" @bind="_draft.Manager" @bind:event="oninput" />
                </div>
                <div class="modal-form-field">
                    <label for="proj-start">Start Date</label>
                    <input id="proj-start" class="input" type="date" @bind="_draft.StartDate" @bind:format="yyyy-MM-dd" />
                </div>
                <div class="modal-form-field">
                    <label for="proj-end">Finish Date</label>
                    <input id="proj-end" class="input" type="date" @bind="_draft.EndDate" @bind:format="yyyy-MM-dd" />
                </div>
                <div class="modal-form-field">
                    <label for="proj-budget">Budget ($)</label>
                    <input id="proj-budget" class="input" type="number" @bind="_draft.Budget" />
                </div>
                <div class="modal-form-field is-span-2">
                    <label for="proj-description">Description</label>
                    <textarea id="proj-description" class="input" rows="3" @bind="_draft.Description" @bind:event="oninput"></textarea>
                </div>
            </div>
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn btn-secondary" @onclick="() => _showNewProjectModal = false">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="SaveNewProject" disabled="@string.IsNullOrWhiteSpace(_draft.Name)">Save Project</button>
        </FooterContent>
    </Modal>
</div>
