@page "/"
@layout MainLayout

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-page">
    <header class="page-header">
        <h1>Dashboard</h1>
        <p>Real-time project controls across the construction portfolio.</p>
    </header>

    @if (_loading)
    {
        <div class="loading-state" aria-live="polite">Loading dashboard…</div>
    }
    @if (_error is not null)
    {
        <div class="alert alert-error" role="alert">@_error</div>
    }

    @if (!_loading && _error is null && _portfolio is not null && _cost is not null && _health is not null)
    {
        <div class="kpi-grid">
            @foreach (var kpi in KpiSummary!)
            {
                <div class="kpi-card @(kpi.To is not null ? "is-clickable" : "")"
                     role="@(kpi.To is not null ? "button" : null)"
                     tabindex="@(kpi.To is not null ? "0" : null)"
                     aria-label="@(kpi.To is not null ? $"View {kpi.Label}" : null)"
                     @onclick="() => { if (kpi.To is not null) GoTo(kpi.To); }"
                     @onkeydown="(e) => OnKpiKeydown(e, kpi)">
                    <div class="kpi-label">@kpi.Label</div>
                    <div class="kpi-value">@kpi.Value</div>
                    <div class="kpi-change @kpi.Tone">
                        <i class="icon icon-@kpi.Icon" aria-hidden="true"></i>
                        @kpi.Trend
                    </div>
                </div>
            }
        </div>

        <div class="two-column-grid">
            <div class="card">
                <div class="card-header">
                    <div>
                        <h2 class="card-title">Cost Performance Trend</h2>
                        <p class="card-subtitle">Earned value vs. actual spend</p>
                    </div>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick='() => GoTo("/reports")'>View report</button>
                </div>
                <div class="bar-chart" role="img" aria-label="Cost performance trend, planned versus actual by month">
                    @foreach (var point in _trend)
                    {
                        <div class="bar-group" tabindex="0"
                             aria-label="@($"{point.Month}: planned {point.Planned}, actual {point.Actual}")"
                             @onmouseenter="() => _hoveredMonth = point.Month" @onmouseleave="() => _hoveredMonth = null"
                             @onfocus="() => _hoveredMonth = point.Month" @onfocusout="() => _hoveredMonth = null">
                            @if (_hoveredMonth == point.Month)
                            {
                                <div class="chart-tooltip" role="tooltip" aria-hidden="true">
                                    <div class="chart-tooltip-title">@point.Month</div>
                                    <div class="chart-tooltip-row">
                                        <span class="chart-tooltip-swatch" style="background: var(--color-accent)"></span>
                                        Planned <strong>@Formatters.FormatCompactCurrency(point.Planned)</strong>
                                    </div>
                                    <div class="chart-tooltip-row">
                                        <span class="chart-tooltip-swatch" style="background: var(--color-border)"></span>
                                        Actual <strong>@Formatters.FormatCompactCurrency(point.Actual)</strong>
                                    </div>
                                </div>
                            }
                            <div class="bar-pair">
                                <div class="bar" style="height: @(BarHeight(point.Planned).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                <div class="bar is-actual" style="height: @(BarHeight(point.Actual).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            </div>
                            <span class="bar-label">@point.Month</span>
                        </div>
                    }
                </div>
                <div class="chart-legend">
                    <span><span class="legend-swatch" style="background: var(--color-accent)"></span>Planned</span>
                    <span><span class="legend-swatch" style="background: var(--color-border)"></span>Actual</span>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <div>
                        <h2 class="card-title">Projects by Health</h2>
                        <p class="card-subtitle">Risk-weighted health distribution</p>
                    </div>
                </div>
                <div class="health-chart" style="display: flex; align-items: center; gap: var(--space-xl)">
                    <div class="donut" style="width: 140px; height: 140px; background: @DonutBackground">
                        <div class="donut-hole">
                            <span>@HealthCounts.Total</span>
                            <small>Projects</small>
                        </div>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: var(--space-sm)">
                        <div class="kpi-change @HealthClasses[HealthStatus.OnTrack]"><span class="status-dot success" aria-hidden="true"></span> @HealthCounts.OnTrack On track</div>
                        <div class="kpi-change @HealthClasses[HealthStatus.AtRisk]"><span class="status-dot warning" aria-hidden="true"></span> @HealthCounts.AtRisk At risk</div>
                        <div class="kpi-change @HealthClasses[HealthStatus.Critical]"><span class="status-dot error" aria-hidden="true"></span> @HealthCounts.Critical Critical</div>
                        <div class="kpi-change @HealthClasses[HealthStatus.NotStarted]"><span class="status-dot" aria-hidden="true"></span> @HealthCounts.NotStarted Not started</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card" style="margin-top: var(--space-xl)">
            <div class="card-header">
                <div>
                    <h2 class="card-title">Schedule at a Glance</h2>
                    <p class="card-subtitle">Next 14 days across the portfolio</p>
                </div>
            </div>
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr><th>Project</th><th>Milestone</th><th>Due Date</th><th>Owner</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @if (_milestones.Count == 0)
                        {
                            <tr><td colspan="5" class="text-secondary" style="text-align: center">No upcoming milestones</td></tr>
                        }
                        @foreach (var m in _milestones)
                        {
                            <tr>
                                <td class="font-mono">@m.ProjectCode</td>
                                <td>@m.Title</td>
                                <td>@Formatters.FormatDate(m.DueDate)</td>
                                <td>@(m.Owner ?? "—")</td>
                                <td><span class="badge @HealthBadgeClass[m.HealthStatus]">@SplitHealthLabel(m.HealthStatus)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
